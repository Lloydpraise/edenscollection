# Copy to .env and fill in. Never commit .env.

# From https://my.telegram.org > API development tools (log in with the Telegram number that has joined
# the supplier's channel). Any app name works, e.g. "Edens sync".
TG_API_ID=
TG_API_HASH=

# The supplier's channel: @username, https://t.me/... link, numeric id (e.g. -1001234567890) or exact title.
# Leave empty and run `npm run login` to list the channels the account can see.
TG_CHANNEL=

# First run only: how many of the channel's latest messages to import.
INITIAL_LIMIT=500
