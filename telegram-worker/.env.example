# Copy to .env and fill in. Never commit .env. The same file works on the laptop and the server.

# Telegram app keys: https://my.telegram.org > API development tools (log in with the number that has joined
# the supplier's channel; any app name works, e.g. "Edens worker").
TG_API_ID=
TG_API_HASH=
# Printed by `npm run login`. Full access to the Telegram account: keep it secret.
TG_SESSION=
# The supplier's channel: @username, t.me link, numeric id (-100...) or exact title. The channel saved in
# /admin (edens_sync_config.channel) wins over this.
TG_CHANNEL=

# VVStudios: Supabase > Project settings > API. The service role key bypasses RLS: server/laptop only.
SUPABASE_URL=https://xgtnbxdxbbywvzrttixf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Normally the business comes from the edens_sync_config row.
EDENS_BUSINESS_ID=

# Optional. The site host's deploy hook, called after a run that changed something so new stock shows.
DEPLOY_HOOK_URL=
